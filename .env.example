# Copie este arquivo para .env e preencha os valores locais.
# Nunca versione o arquivo .env nem compartilhe a chave SMTP.
MONGODB_URI=mongodb://localhost:27017/pizzaria
MONGODB_DATABASE=pizzaria

# Credenciais SMTP do Brevo (Brevo > SMTP & API > SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Use um remetente previamente validado na sua conta Brevo.
MAIL_FROM=
APP_BASE_URL=http://localhost:8080
